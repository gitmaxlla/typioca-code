@startuml activity-main
skinparam defaultFontName "DejaVu Sans"
skinparam backgroundColor white
skinparam shadowing false

start
:Запустить `typioca`;
:Открыть главное меню;

if (Нужно изменить наборы\nили раскладку?) then (да)
  :Открыть Config;
  :Включить или синхронизировать набор;
endif

:Выбрать режим: время, слова или предложения;
:Выбрать параметр и набор;
:Начать тест;

while (Тест завершён?) is (нет)
  :Ввести символ;
  if (Символ совпал?) then (да)
    :Подсветить как верный;
  else (нет)
    :Подсветить ошибку;
  endif
endwhile (да)

:Рассчитать WPM, CPM и точность;
:Сохранить результат;
:Показать экран результатов;

if (Повторить тест?) then (да)
  :Запустить тот же тест;
else (нет)
  :Вернуться в главное меню;
endif

stop
@enduml
